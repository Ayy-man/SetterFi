# SetterFi environment contract. Values belong in local/Vercel configuration only.
SHADCNBLOCKS_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SETTERFI_ACCESS_PASSWORD=
SETTERFI_AUTH_MODE=
# One-click demo sign-in buttons on /login. They ship real working credentials in
# server-rendered HTML, so leave this unset anywhere real coaches can reach.
# Production also requires the explicit review override and SETTERFI_ACCESS_PASSWORD;
# that shared gate wraps /login before any credential reaches the browser.
SETTERFI_DEMO_LOGINS=
SETTERFI_DEMO_LOGIN_PASSWORD=
SETTERFI_PRODUCTION_DEMO_LOGINS=

# Phase 1 is inert until this gate is explicitly enabled.
SETTERFI_PHASE1_LIVE=
SETTERFI_PIPELINE_WRITE_LIVE=
SETTERFI_BOOKING_CONFIRM_LIVE=
SETTERFI_APPOINTMENT_LIFECYCLE_LIVE=
SETTERFI_INBOX_VERBS_LIVE=
SETTERFI_PHASE2_LIVE=
SETTERFI_PLATFORM_CONVERSATION_QUEUE_LIVE=
SETTERFI_PHASE4_LIVE=
SETTERFI_CONTACT_MANAGEMENT_LIVE=
SETTERFI_WHATSAPP_EMBEDDED_SIGNUP=
SETTERFI_GHL_DRIVER=
SETTERFI_OPENROUTER_DRIVER=
SETTERFI_META_DRIVER=
SETTERFI_NOTION_DRIVER=
SETTERFI_EMBEDDINGS_DRIVER=
SETTERFI_TAG_SECRET=
SETTERFI_SUPPRESSION_PEPPER=
SETTERFI_CREDENTIAL_ENCRYPTION_KEY=
CRON_SECRET=

# Provider configuration. Real-driver tests remain skipped until their named arm is complete.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_WEBHOOK_PUBLIC_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
NOTION_API_KEY=
NOTION_KB_ROOT_ID=
NOTION_EXPORT_PATH=
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_SYSTEM_USER_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_SYSTEM_USER_TOKEN=
META_WABA_ID=
META_WHATSAPP_PHONE_NUMBER_ID=
APP_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The GHL calendar probe is restricted to an explicitly named test resource.
SETTERFI_GHL_TEST_ACCESS_TOKEN=
SETTERFI_GHL_TEST_LOCATION_ID=
SETTERFI_GHL_TEST_CALENDAR_ID=
SETTERFI_GHL_TEST_CONTACT_ID=

# Phase 3 remains inert until each named behavior is explicitly enabled.
SETTERFI_PHASE3_LIVE=
SETTERFI_SUPPRESSION_SYNC_LIVE=
SETTERFI_CONTACT_DELETE_LIVE=

# Phase 5 remains inert and provider provisioning remains mock until explicitly enabled.
SETTERFI_PHASE5_LIVE=
SETTERFI_SIGNUP_REPAIR_LIVE=
SETTERFI_GHL_PROVISIONING_DRIVER=
GHL_AGENCY_ACCESS_TOKEN=
GHL_AGENCY_COMPANY_ID=
GHL_SNAPSHOT_ID=
GHL_NUMBER_POOL_ID=
SETTERFI_A2P_PROBE_TARGET=
SETTERFI_A2P_PROBE_TARGET_HASH=
SETTERFI_DEMO_PLACEHOLDER_CONSENT_VERSION=
SETTERFI_DEMO_PLACEHOLDER_CAMPAIGN_COPY_VERSION=

# Phase 6 remains inert and Stripe remains mock until explicitly enabled.
SETTERFI_PHASE6_LIVE=
SETTERFI_PHASE6_AFFILIATES_LIVE=
SETTERFI_PHASE6_STRIPE_LIVE=
SETTERFI_CHECKOUT_ATTEMPTS_LIVE=
SETTERFI_STRIPE_DRIVER=
SETTERFI_DEMO_PLACEHOLDER_TIER_PRICES=
SETTERFI_DEMO_PLACEHOLDER_ALLOWANCE_NOTICE=
SETTERFI_DEMO_PLACEHOLDER_DISPUTE_PATH=
SETTERFI_DEMO_PLACEHOLDER_AFFILIATE_TERMS=

# Phase 7 remains inert until its parent and each named behavior are explicitly enabled.
SETTERFI_PHASE7_LIVE=
SETTERFI_PHASE7_ANALYTICS_LIVE=
SETTERFI_PHASE7_EVALS_LIVE=
SETTERFI_PHASE7_MEET_AGENT_LIVE=
# Synthetic platform metrics for the explicitly demo-login review build only. Real analytics
# always remains the analytics_* projection and never includes this snapshot.
SETTERFI_PLATFORM_PREVIEW_DATA=

# Phase 8 remains inert and outbound notification drivers remain mock until explicitly enabled.
SETTERFI_PHASE8_LIVE=
SETTERFI_PHASE8_ALERTS_LIVE=
SETTERFI_PHASE8_ALERT_RULE_EVENTS_LIVE=
SETTERFI_PHASE8_SUPPORT_LIVE=
SETTERFI_PHASE8_EXPORTS_LIVE=
SETTERFI_PHASE8_ENGINE_EVAL_LIVE=
SETTERFI_EMAIL_DRIVER=
RESEND_API_KEY=
RESEND_WEBHOOK_SIGNING_SECRET=
SETTERFI_EMAIL_FROM=
SETTERFI_SLACK_DRIVER=
SLACK_WEBHOOK_URL=

# Phase 9 remains inert until its parent and the OAuth install path are explicitly enabled.
# The agency install is stored and self-refreshing once a callback lands; GHL_AGENCY_ACCESS_TOKEN
# above is a bootstrap-only fallback and expires roughly 24 hours after it is set.
SETTERFI_PHASE9_LIVE=
SETTERFI_PHASE9_GHL_OAUTH_LIVE=
GHL_AGENCY_CLIENT_ID=
GHL_AGENCY_CLIENT_SECRET=
# The two install links are portal-issued overrides. When one is set it is used verbatim (plus our
# redirect_uri and state); when blank the authorization URL is built from the app's client id,
# redirect URI, response_type=code and the app's scope list. The override stays the default because
# a portal link carries version_id, which HighLevel's OAuth docs do not document as of 2026-09-02.
GHL_INSTALL_URL=
GHL_AGENCY_INSTALL_URL=

# Phase 10: the Brain's objection runtime stays inert until SETTERFI_PHASE2_LIVE and this key are
# both exactly "true". Nothing reads it yet. Publication writes the snapshot rows regardless, and
# matching, hard-gate enforcement and the rollup arrive behind this flag in later plans.
SETTERFI_BRAIN_OBJECTIONS_LIVE=

# Signed-in session management and deliberate password changes remain off until reviewed.
SETTERFI_ACCOUNT_SECURITY_LIVE=

# Second-factor enrollment needs SETTERFI_ACCOUNT_SECURITY_LIVE as well.
SETTERFI_ACCOUNT_MFA_LIVE=

# Email change moves only the application row today, not the Supabase Auth identity, so it needs
# SETTERFI_ACCOUNT_SECURITY_LIVE and this, and should stay off until the two stores agree.
SETTERFI_ACCOUNT_EMAIL_CHANGE_LIVE=

# Teammate invitations remain inert until this is explicitly enabled.
SETTERFI_TENANT_MEMBERSHIP_LIVE=

# Ownership transfer needs SETTERFI_TENANT_MEMBERSHIP_LIVE as well; it moves the role that can end
# another member's access.
SETTERFI_TENANT_OWNERSHIP_LIVE=

# Signup records a terms acceptance receipt only once approved copy is published behind this gate.
SETTERFI_ACCOUNT_TERMS_LIVE=

# Effective-dated commercial terms on the tier catalogue.
SETTERFI_TIER_OFFER_TERMS_LIVE=

# Loads the coach's real voice answers, proof and assets into the engine. Off, the agent keeps
# running on the empty values it has always received. Turning this on changes agent output for
# every tenant at once, so switch it on a watched tenant first.
SETTERFI_OFFER_LAYER_ENGINE_INPUT_LIVE=
SETTERFI_PUBLIC_LANDING_LIVE=
# Meta Conversions API for Business Messaging. Blank keeps deterministic mock delivery.
SETTERFI_CAPI_LIVE=

# Google Calendar connect. Blank keeps all four /api/calendars/google routes at 404 and keeps the
# Connect button off /onboarding/calendar. The two credentials already exist in Vercel and in
# .env.local and were deliberately kept out of this file until the contract wiring landed; the
# secret is never printed anywhere, and it is due for rotation because it transited chat once.
SETTERFI_GOOGLE_CALENDAR_OAUTH_LIVE=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# First-customer build gate. Blank or "true": a production build with live flags whose providers
# lack real credentials FAILS (the honest default). Exactly "false": the verifier prints the full
# missing/invalid list in the build log and lets the build proceed — the 2026-09-02 state, while
# the launch credential list is being filled. Delete the variable to re-arm.
SETTERFI_FIRST_CUSTOMER_ENFORCE=
