flowchart LR
  subgraph LEGEND[Legend]
    direction LR
    L1[BLUE = Built by us and working today]:::built
    L2[RED = Long lead - built but waiting on an outside account]:::waiting
    L3[AMBER = Alec - needs a decision or an account from you]:::owed
    L4[GREY = Set aside for a later phase]:::later
    L1 ~~~ L2 ~~~ L3 ~~~ L4
  end

  subgraph WHO[1 - Who uses it]
    direction TB
    W1[Coaches - credit and funding coaches who subscribe]:::built
    W2[Leads - the people who message a coach]:::built
    W3[Your team - runs the platform and edits The Brain]:::built
    W4[Affiliates - refer coaches and earn commission]:::built
    W1 ~~~ W2 ~~~ W3 ~~~ W4
  end

  subgraph SIGNUP[2 - Sign up, steps 1 to 6]
    direction TB
    S1[1 - Coach opens the public sign up page]:::built
    S2[2 - Coach picks a plan - no plan is published yet so sign up is switched off today]:::owed
    S3[3 - Account and workspace created - the password is never stored in our tables]:::built
    S4[4 - Coach accepts the terms - the approved legal wording is still owed]:::owed
    S5[5 - A texting sub account and phone number are set up automatically - waiting on two settings from the texting provider portal]:::waiting
    S6[6 - Carrier registration for texting - two to three weeks shown as a day counter, never a percentage]:::waiting
    S1 --> S2 --> S3 --> S4 --> S5 --> S6
  end

  subgraph SETUP[3 - Sign up, steps 7 to 12]
    direction TB
    T1[7 - Coach connects Instagram and Facebook - waiting on Meta app approval and keys]:::waiting
    T2[8 - Coach connects the texting provider calendar]:::built
    T3[8b - Google Calendar sign in - built and switched off until Google approves the app, which needs your public website and privacy page]:::owed
    T4[9 - Coach sets their offer - prices, products, disqualifiers and voice]:::built
    T5[10 - Test conversation proves the agent answers and the calendar responds - nothing is booked]:::built
    T6[11 - Coach pays by card on the payment provider page - real payments only, no fake success possible, waiting on your live payment keys]:::owed
    T7[12 - Go live - checked against seven proofs including payment]:::built
    T1 --> T2 --> T3 --> T4 --> T5 --> T6 --> T7
  end

  subgraph INSIDE[4 - A lead messages]
    direction TB
    I1[A lead sends a DM or text - texts arrive today, Instagram and Facebook wait on Meta]:::waiting
    I2[Message saved once - duplicates ignored]:::built
    I3[Opt outs and permission checked before any reply]:::built
    I4[Agent finds the answer in The Brain - published knowledge only, never drafts]:::built
    I5[Numbers, prices and guarantees checked before sending - anything unsupported is held for a human]:::built
    I6[Reply sent to the lead - texts today, Instagram and Facebook wait on Meta]:::waiting
    I7[A qualified lead is booked into the calendar]:::built
    I8[Follow ups every five minutes - a booked chat is never booked twice]:::built
    I9[Conversion signals sent to Meta ads - held until you decide the purchase value]:::owed
    I1 --> I2 --> I3 --> I4 --> I5 --> I6 --> I7 --> I8 --> I9
  end

  subgraph COACH[5 - Coach workspace]
    direction TB
    C1[Overview and analytics - real numbers only, test data kept out]:::built
    C2[Inbox - read, take over a conversation, reply by hand, hand back]:::built
    C3[Contacts and pipeline stages]:::built
    C4[Agent settings - the offer layer only, never the shared Brain]:::built
    C5[Billing page - shows the plan and opens card payment once your payment keys are in]:::owed
    C6[Every table downloads as a spreadsheet or data file]:::built
    C7[Password change, two factor, teammates and the notification bell - built behind the scenes, no page shows them yet]:::later
    C1 ~~~ C2 ~~~ C3 ~~~ C4 ~~~ C5 ~~~ C6 ~~~ C7
  end

  subgraph TEAM[6 - Team console]
    direction TB
    A1[The Brain - draft, import from Notion, evaluate, publish to every coach at once, roll back]:::built
    A2[Publishing is blocked unless the safety checks pass]:::built
    A3[Client book - each success person owns coaches, can view as a coach read only, every action logged]:::built
    A4[Texting provider marketplace install - one approval on a call with you]:::waiting
    A5[Plan prices and terms - the table is empty until you set them]:::owed
    A6[Alerts by email - built, waiting on an email account from you]:::owed
    A7[Audit log of every privileged action, marked Logged]:::built
    A9[Two operator walkthrough recordings - not yet made]:::later
    A1 ~~~ A2 ~~~ A3 ~~~ A4 ~~~ A5 ~~~ A6 ~~~ A7 ~~~ A9
  end

  subgraph AFFIL[7 - Affiliates]
    direction TB
    F1[Portal shows only the referred coach name, status and commission earned - built, not yet opened by a real affiliate]:::built
    F2[Referral locked to the coach at sign up and never changed]:::built
    F3[Commission rate and an affiliate sign up page - your decision]:::owed
    F4[Paying affiliates out - unproven end to end]:::later
    F1 ~~~ F2 ~~~ F3 ~~~ F4
  end

  subgraph PROTECT[8 - Always on protections]
    direction TB
    P1[Each coach sees only their own data - enforced in the database, not just the screen]:::built
    P2[Audit and money records can be added to, never edited or deleted]:::built
    P3[Instagram, Facebook and texting tokens stored encrypted]:::built
    P4[One older calendar token table is still stored unencrypted - not fixed yet]:::owed
    P5[The agent cannot invent a price, a guarantee or a source]:::built
    P6[The agent cannot publish The Brain, change billing or send outside its one send path]:::built
    P7[No reply unless permission to message is on record]:::built
    P8[Card numbers can never be stored - only the last four digits]:::built
    P9[Background jobs and incoming provider messages are refused without the secret key or a valid signature]:::built
    P1 ~~~ P2 ~~~ P3 ~~~ P4 ~~~ P5 ~~~ P6 ~~~ P7 ~~~ P8 ~~~ P9
  end

  subgraph OUTSIDE[9 - Outside accounts]
    direction TB
    O1[Meta app review - Instagram and Facebook messaging cannot connect until approved]:::waiting
    O2[Carrier registration for texting - two to three weeks per coach]:::waiting
    O3[Texting provider agency install - pending the call with you]:::waiting
    O1 ~~~ O2 ~~~ O3
  end

  subgraph OWED[10 - Alec still owes]
    direction TB
    D1[Plan names, prices and terms - sign up stays off until then]:::owed
    D2[Live payment provider keys]:::owed
    D3[Meta app credentials from your business portfolio]:::owed
    D4[An email sending account for alerts]:::owed
    D5[An OpenAI account key for the Brain search index - without it the agent cannot look anything up]:::owed
    D6[Purchase value ruling for ad conversion events]:::owed
    D7[Approved legal copy - account terms, privacy, texting campaign wording]:::owed
    D8[Escalation contacts and provider cost rates for the handover pack]:::owed
    D9[Sign off on the open product decisions]:::owed
    D1 ~~~ D2 ~~~ D3 ~~~ D4 ~~~ D5 ~~~ D6 ~~~ D7 ~~~ D8 ~~~ D9
  end

  LEGEND --> WHO --> SIGNUP --> SETUP --> INSIDE --> COACH --> TEAM --> AFFIL --> PROTECT --> OUTSIDE --> OWED

