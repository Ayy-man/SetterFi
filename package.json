{
  "name": "setterfi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "probe:ghl-contract": "node scripts/probe-ghl-contract.mjs",
    "build": "node scripts/verify-env-contract.mjs --profile=first-customer --if-vercel-production && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest run --project ui",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:update": "playwright test --update-snapshots",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:ui",
    "verify:rotation": "node scripts/verify-provider-rotation.mjs",
    "generate:handover": "node --experimental-strip-types scripts/generate-phase8-handover.mjs",
    "test:rls": "vitest run --config vitest.rls.config.mts",
    "verify:measurement-hosted": "node scripts/verify-measurement-hosted.mjs",
    "db:migrate": "supabase migration up --include-all",
    "demo:env-check": "node scripts/verify-env-contract.mjs",
    "verify:env:first-customer": "node scripts/verify-env-contract.mjs --profile=first-customer",
    "demo:seed": "node scripts/seed-phase1-demo.mjs",
    "demo:seed-phase2": "node scripts/seed-phase2-demo.mjs",
    "demo:seed-phase5": "node scripts/seed-phase5-demo.mjs",
    "demo:seed-phase6": "node scripts/seed-phase6-demo.mjs",
    "demo:seed-phase7": "node scripts/seed-phase7-demo.mjs",
    "demo:seed-phase8": "node scripts/seed-phase8-demo.mjs",
    "demo:seed-complete": "node scripts/seed-demo-complete.mjs",
    "demo:seed-gaps": "node scripts/seed-demo-gaps.mjs",
    "demo:seed-showcase": "node scripts/seed-showcase-leads.mjs",
    "demo:seed-platform-review": "node --env-file-if-exists=.env.local scripts/seed-platform-review-data.mjs",
    "demo:contract-phase5": "node scripts/phase5-demo-contract.mjs",
    "demo:test-phase5": "npm run demo:seed-phase5 && npm run demo:seed-phase5 && npm run demo:contract-phase5 -- --expect=seeded && npm run demo:reset-phase5 && npm run demo:contract-phase5 -- --expect=reset",
    "demo:run": "node scripts/run-phase1-demo.mjs",
    "demo:run-phase6": "node scripts/run-phase6-demo.mjs",
    "demo:run-phase7": "node scripts/run-phase7-demo.mjs",
    "demo:run-phase8": "node scripts/run-phase8-demo.mjs",
    "demo:reset": "node scripts/reset-phase1-demo.mjs",
    "demo:reset-phase2": "node scripts/reset-phase2-demo.mjs",
    "demo:reset-phase5": "node scripts/reset-phase5-demo.mjs",
    "demo:reset-phase6": "node scripts/reset-phase6-demo.mjs",
    "demo:reset-phase7": "node scripts/reset-phase7-demo.mjs",
    "demo:reset-phase8": "node scripts/reset-phase8-demo.mjs",
    "demo:reset-platform-review": "node scripts/reset-platform-review-data.mjs",
    "gate:phase8": "node scripts/phase8-gate.mjs",
    "gate:phase11": "node scripts/phase11-gate.mjs",
    "test:rls:clean": "node scripts/run-rls-suite.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.9.1",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.86.0",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.8",
    "stripe": "22.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
