# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage
/test-results/
/playwright-report/
/e2e/.auth/
# Visual baselines are committed on purpose.
!/e2e/visual.spec.ts-snapshots/
!/e2e/visual.spec.ts-snapshots/**

# next.js
/.next/
# NEXT_DIST_DIR builds, for building beside a running dev server
/.next-*/
/out/

# production
/build

# local environment files, including the premium registry key
.env*
!.env.example
!.env.e2e.example

# local tooling
.vercel
*.tsbuildinfo
next-env.d.ts

# logs and operating-system files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
*.pem

# call transcripts (raw, not for client-shared repo)
.calls/

# raw Notion captures, verbatim client content and per-coach pricing;
# the sanitized structural map lives in docs/NOTION-MAP.md instead
.notion/

# machine-local Claude Code state (shared skills/agents under .claude/ stay tracked)
.claude/settings.local.json
.claude/RELEASE-NOTES.md
.claude/RESUME.md
.claude/scheduled_tasks.lock
